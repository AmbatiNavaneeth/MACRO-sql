15. Department-wise Minimum and Maximum Salary
select dept_id
       min(salary) as min,
       max(salary) as max
from departments
group by dept_id;

--if two tables---
SELECT d.dept_name,
       MIN(e.salary) AS minimum_salary,
       MAX(e.salary) AS maximum_salary
FROM Employee e
JOIN Department d
ON e.dept_id = d.dept_id
GROUP BY d.dept_name;

