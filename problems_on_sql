SELECT 
    DATE_FORMAT(sale_date, '%Y-%m') AS sales_month, 
    COUNT(*) AS total_transactions, 
    SUM(amount) AS total_revenue
FROM Sales
GROUP BY DATE_FORMAT(sale_date, '%Y-%m')
ORDER BY sales_month DESC;

