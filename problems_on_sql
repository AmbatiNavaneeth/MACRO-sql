1. Find 2nd Highest Salary
Using Employee(emp_id, emp_name, salary)

---Using LIMIT -----
SELECT DISTINCT salary
FROM Employee
ORDER BY salary DESC
LIMIT 1 OFFSET 1;

----Using Subquery---
SELECT MAX(salary)
FROM Employee
WHERE salary < (
    SELECT MAX(salary)
    FROM Employee
);

2. Find Duplicate Records
Using Students(id, name, email)
Find duplicate email IDs from the table.

select email,count(*) 
from students
group by email
having count(*)>1;

3. Department-wise Maximum Salary
Using:
Employee(emp_id, emp_name, dept_id, salary)
Department(dept_id, dept_name)
Find the highest salary employee in each department.

select e.emp_name,
       e.dept_name,
       e.salary
from employees e
join department d            -(#innerjoin)
on e.dept_=d.dept_id
where e.salary=
(
select max(salary) 
from employees
where dept_id=e.dept_id
);


